#include<bits/stdc++.h>
using namespace std;
 
int main()
{
    int t;
    cin>>t;
    while(t--){
        long long n,sum=0;
        cin>>n;
        int arr[n];
 
        for(int i=0 ; i<n ; i++){
            cin>>arr[i];
        }
 
        for(int i=0 ; i<n ; i++){
            sum+=arr[i];
        }
 
        long long k = sqrt(sum);
        if(k*k == sum){
            cout<<"YES"<<endl;
        }else{
            cout<<"NO"<<endl;
        }
 
    }
 
}