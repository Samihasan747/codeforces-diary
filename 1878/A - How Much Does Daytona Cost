#include<bits/stdc++.h>
using namespace std;
 
int main()
{
    int t;
    cin>>t;
 
    while(t--){
        int n,x,countx=0;
        cin>>n>>x;
        vector<int> arr(n);
 
        for(int i=0 ; i<n ; i++){
            cin>>arr[i];
        }
        for(int i=0 ; i<n ; i++){
            if(arr[i] == x){
                countx++;
            }
        }
        if(countx > 0){
            cout<<"YES"<<endl;
        }else{
            cout<<"NO"<<endl;
        }
    }
}
 