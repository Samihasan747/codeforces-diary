#include<bits/stdc++.h>
using namespace std;
 
int main()
{
    int n,a=0,b=0;
    cin>>n;
    string s;
 
    while(n>0)
    {
        cin>>s;
 
    for(int i=0 ; i<6 ; i++)
    {
        if(i==0 || i==1 || i==2)
            a+=s[i];
        else
            b+=s[i];
    }
    n--;
    if(a == b)
        cout<<"YES"<<endl;
    else
        cout<<"NO"<<endl;
    a=0;
    b=0;
    }
}